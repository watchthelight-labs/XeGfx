+ * SPDX-License-Identifier: MIT
+ *
+ * XeGfx (Darwin): dma-buf and sync_file file descriptors in userspace. A kext cannot create file descriptors, so
+ * PRIME export, sync_file export and syncobj sync_file export cannot happen in the kernel. drmIoctl() answers them
+ * here instead, with stand-in descriptors: each is the read end of a pipe whose write end is closed, remembered
+ * with its inode so a recycled number is noticed. A dma-buf stands for (DRM file, GEM handle); a sync_file stands
+ * for a syncobj on that DRM file, filled and drained by the XeGfx ioctls 'N' 0x42/0x43 and SYNCOBJ_TRANSFER.
+ *
+ * Limits: a stand-in only works on the DRM file it came from; poll() on a sync_file stand-in always reports
+ * ready; opaque syncobj fds are snapshots, not shared syncobjs; SYNC_IOC_MERGE is not supported.
+ * <wtl> project: xegfx | author: watchthelight </wtl>
+ */
+#ifdef __APPLE__
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <IOKit/IOKitLib.h>
